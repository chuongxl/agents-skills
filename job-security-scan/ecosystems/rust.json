{
  "schema_version": 1,
  "id": "rust",
  "name": "Rust (Cargo)",
  "detect": [
    "Cargo.toml"
  ],
  "lockfiles": [
    "Cargo.lock"
  ],
  "osv_ecosystem": "crates.io",
  "semgrep": [
    "p/rust"
  ],
  "docker": {
    "images": [
      "rust"
    ]
  },
  "runtime": {
    "name": "rust",
    "extractors": [
      {
        "file": "rust-toolchain.toml",
        "regex": "channel\\s*=\\s*\"([^\"]+)\""
      },
      {
        "file": "rust-toolchain",
        "regex": "^(\\d[\\w.]*)"
      }
    ],
    "eol_product": "rust"
  }
}
