{
  "schema_version": 1,
  "id": "go",
  "name": "Go modules",
  "detect": [
    "go.mod"
  ],
  "lockfiles": [
    "go.mod"
  ],
  "osv_ecosystem": "Go",
  "semgrep": [
    "p/golang"
  ],
  "docker": {
    "images": [
      "golang"
    ]
  },
  "runtime": {
    "name": "go",
    "extractors": [
      {
        "file": "go.mod",
        "regex": "^go\\s+(\\d[\\w.]*)"
      },
      {
        "file": ".tool-versions",
        "regex": "^golang\\s+(\\S+)"
      }
    ],
    "eol_product": "go"
  }
}
