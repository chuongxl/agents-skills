{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chuongxl/agents-skills/job-security-scan/assets/report.schema.json",
  "title": "job-security-scan security-report.json (schema v2)",
  "description": "Documentation mirror of scripts/validate-report.py, which is the enforced contract. Rules a JSON Schema cannot express are enforced there only: unique fingerprints, counts and verification summary match the findings, verified_severity never above demonstrated impact, no code excerpt on secret rows.",
  "type": "object",
  "required": ["schema_version", "generated_at", "team", "org", "run_dir", "run", "scanners", "counts", "repos", "fixed", "verification", "findings"],
  "properties": {
    "schema_version": {"const": 2},
    "generated_at": {"type": "string"},
    "team": {"type": "string"},
    "org": {"type": "string"},
    "config": {"type": "string"},
    "run_dir": {"type": "string"},
    "run": {
      "type": "object",
      "required": ["profile", "since", "partial", "previous_run"],
      "properties": {
        "profile": {"enum": ["quick", "standard", "deep"]},
        "since": {"type": ["string", "null"]},
        "partial": {"type": "boolean"},
        "previous_run": {"type": ["string", "null"]},
        "coverage": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "scanners": {"type": "array", "items": {"type": "string"}},
    "counts": {"$ref": "#/$defs/counts"},
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "counts", "secrets"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["red", "yellow", "green"]},
          "counts": {"$ref": "#/$defs/counts"},
          "secrets": {"type": "integer", "minimum": 0}
        }
      }
    },
    "skipped": {"type": "array"},
    "fixed": {"type": "array", "items": {"type": "object", "required": ["fingerprint"]}},
    "verification": {
      "type": "object",
      "required": ["profile", "queued", "pending", "confirmed", "needs_validation", "rejected"],
      "properties": {
        "profile": {"enum": ["quick", "standard", "deep"]},
        "queued": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0},
        "confirmed": {"type": "integer", "minimum": 0},
        "needs_validation": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
    "counts": {
      "type": "object",
      "required": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "finding": {
      "type": "object",
      "required": ["repo", "scanner", "type", "severity", "file", "line", "code", "rule_id", "title", "fingerprint", "change", "verdict", "verified_severity", "verdict_detail"],
      "properties": {
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "change": {"enum": ["new", "unchanged"]},
        "severity": {"$ref": "#/$defs/severity"},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "verdict": {"enum": [null, "confirmed", "needs_validation", "rejected"]},
        "verified_severity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/severity"}]},
        "carried": {"type": "boolean"},
        "verdict_detail": {
          "type": "object",
          "properties": {
            "evidence": {"type": "string"},
            "likelihood": {"enum": ["high", "medium", "low"]},
            "impact": {"enum": ["critical", "high", "medium", "low", "informational"]},
            "blocker": {"type": "string"},
            "validation_plan": {"type": "string"},
            "reason": {"type": "string"}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"verdict": {"const": "confirmed"}}},
         "then": {"properties": {"verified_severity": {"$ref": "#/$defs/severity"},
                                 "verdict_detail": {"required": ["evidence", "likelihood", "impact"]}}}},
        {"if": {"properties": {"verdict": {"const": "needs_validation"}}},
         "then": {"properties": {"verified_severity": {"type": "null"},
                                 "verdict_detail": {"required": ["blocker", "validation_plan"]}}}},
        {"if": {"properties": {"verdict": {"const": "rejected"}}},
         "then": {"properties": {"verified_severity": {"type": "null"},
                                 "verdict_detail": {"required": ["reason"]}}}},
        {"if": {"properties": {"type": {"const": "secret"}}},
         "then": {"properties": {"code": {"const": ""}}}}
      ]
    }
  }
}
